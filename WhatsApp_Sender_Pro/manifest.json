{
  "manifest_version": 3,
  "name": "WhatsApp Sender Pro",
  "version": "1.9.2",
  "description": "Abre chats de WhatsApp sin agendar el número, con agenda de contactos, notas y plantillas de texto.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "clipboardRead", "clipboardWrite", "alarms", "nativeMessaging"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Sender Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
